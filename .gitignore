# =============================================================================
# LLM Guardian — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# pytest / test cache
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# mypy / pyright type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# Environment Variables & Secrets — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# API Keys (just in case)
secrets.json
secrets.yaml
secrets.toml

# -----------------------------------------------------------------------------
# Frontend (Node.js / Vite / React)
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/*.local
frontend/.DS_Store

# npm / yarn / pnpm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# Parcel cache
.parcel-cache/

# Storybook
storybook-static/

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd/

# -----------------------------------------------------------------------------
# Windows
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Linux
# -----------------------------------------------------------------------------
*~

# -----------------------------------------------------------------------------
# IDEs & Editors
# -----------------------------------------------------------------------------

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.#*

# -----------------------------------------------------------------------------
# ML / AI Model Artifacts (can be large; regenerated at runtime)
# -----------------------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.pkl
*.joblib
*.safetensors
models/
model_cache/
huggingface_cache/
.cache/huggingface/
sentence_transformers/

# -----------------------------------------------------------------------------
# Logs & Runtime Files
# -----------------------------------------------------------------------------
*.log
logs/
*.pid

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
.history/
